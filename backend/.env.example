# Copy this file to ".env" and fill it in. NEVER commit ".env" (it is in .gitignore).

# Port the API listens on. The frontend's VITE_API_URL should be http://localhost:3000/api
PORT=3000

# MongoDB connection string (Atlas or local). The database name is forced to "dbRestaurants"
# by the code, so it does not matter if your URI ends in another name.
#   Atlas : mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/?retryWrites=true&w=majority
#   Local : mongodb://127.0.0.1:27017
MONGODB_URI=

# Exact address of the frontend (scheme + host + port, no trailing slash).
# Several origins can be separated with commas.
CLIENT_ORIGIN=http://localhost:5173

# --- Optional -------------------------------------------------------------------------------
# DB_NAME=dbRestaurants
# Cookie that identifies each browser (favorites/reviews). Defaults suit localhost development.
# COOKIE_SAMESITE=lax        # use "none" only when the frontend is hosted on a different site (needs HTTPS)
# COOKIE_SECURE=false        # must be true when COOKIE_SAMESITE=none or when served over HTTPS
# USE_PUBLIC_DNS=true        # Atlas (mongodb+srv) only: use Google/Cloudflare DNS. Set false to use your system DNS.
